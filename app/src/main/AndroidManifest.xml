<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================== -->
    <!-- PERMISOS                                              -->
    <!-- ===================================================== -->

    <!-- Internet: descargar el mapa y buscar los puntos de interés -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Ubicación PRECISA (GPS). Se pide también en tiempo de ejecución. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Ubicación APROXIMADA (red/wifi). Desde Android 12 el usuario
         puede elegir dar solo esta, por eso se piden las dos. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- La app funciona aunque el teléfono no tenga GPS (usa la red) -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Reto9GPS"
        tools:targetApi="31">

        <!-- Pantalla principal: el mapa -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Ajustes (radio en km, tipo de lugar) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
